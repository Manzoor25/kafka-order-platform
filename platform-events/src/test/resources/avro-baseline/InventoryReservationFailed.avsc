{
  "type": "record",
  "name": "InventoryReservationFailed",
  "namespace": "io.orderplatform.events.avro",
  "doc": "Emitted by inventory-service when stock is insufficient; triggers payment refund.",
  "fields": [
    { "name": "eventId", "type": "string" },
    { "name": "orderId", "type": "string" },
    { "name": "sku", "type": "string" },
    { "name": "requestedQuantity", "type": "int" },
    { "name": "availableQuantity", "type": "int" },
    { "name": "reason", "type": "string" },
    { "name": "customerEmail", "type": "string" },
    { "name": "occurredAtEpochMs", "type": "long" }
  ]
}
